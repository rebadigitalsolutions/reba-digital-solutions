# Copy to .env.local for development. Keep real values out of source control.
# Canonical site host, no trailing slash. Used for canonicals, sitemap, OG tags and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.rebadigitalsolutions.com
RESEND_API_KEY=
# Must be a sender on a domain verified in your Resend account.
CONTACT_FROM_EMAIL=Reba Digital Solutions <website@rebadigitalsolutions.com>
# Optional; omit to use the business inbox already listed in the project.
CONTACT_TO_EMAIL=hello@rebadigitalsolutions.com
